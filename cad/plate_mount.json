{"commands": [
  {"command": "parameters.add", "params": {"name": "plate_w", "expression": "120", "comment": "assumed: 板の幅(x)。MJCF の chassis と同じ。Robo Base の上板は未測定"}},
  {"command": "parameters.add", "params": {"name": "plate_d", "expression": "90", "comment": "assumed: 板の奥行(y)"}},
  {"command": "parameters.add", "params": {"name": "plate_t", "expression": "3", "comment": "assumed: 板厚。作る材料で決まる"}},
  {"command": "parameters.add", "params": {"name": "xiao_w", "expression": "21", "comment": "datasheet: XIAO nRF52840 の外形 21 x 17.8 mm (dimensions.csv)"}},
  {"command": "parameters.add", "params": {"name": "xiao_d", "expression": "17.8", "comment": "datasheet: 同上"}},
  {"command": "parameters.add", "params": {"name": "xiao_clearance", "expression": "0.3", "comment": "assumed: 窓の片側の逃げ。設計者の選択で、測った値ではない"}},
  {"command": "parameters.add", "params": {"name": "TBD_robo_hole_dx", "expression": "100", "comment": "仮の値(未確認): Robo Base の上板の取付穴の x 方向の間隔。届いて測ったらこの 1 つを直す"}},
  {"command": "parameters.add", "params": {"name": "TBD_robo_hole_dy", "expression": "60", "comment": "仮の値(未確認): 同 y 方向の間隔"}},
  {"command": "parameters.add", "params": {"name": "TBD_robo_hole_d", "expression": "3.2", "comment": "仮の値(未確認): 取付穴の径。M3 の通し穴を仮置き"}},

  {"command": "sketch.create", "params": {"plane": "XY"}},
  {"command": "sketch.rectangle.center", "params": {"center": [0, 0], "corner": ["plate_w/2", "plate_d/2"]}},
  {"command": "sketch.rectangle.center", "params": {"center": [0, 0], "corner": ["(xiao_w+2*xiao_clearance)/2", "(xiao_d+2*xiao_clearance)/2"]}},
  {"command": "sketch.circle.center", "params": {"center": ["TBD_robo_hole_dx/2", "TBD_robo_hole_dy/2"], "diameter": "TBD_robo_hole_d"}},
  {"command": "sketch.circle.center", "params": {"center": ["-TBD_robo_hole_dx/2", "TBD_robo_hole_dy/2"], "diameter": "TBD_robo_hole_d"}},
  {"command": "sketch.circle.center", "params": {"center": ["-TBD_robo_hole_dx/2", "-TBD_robo_hole_dy/2"], "diameter": "TBD_robo_hole_d"}},
  {"command": "sketch.circle.center", "params": {"center": ["TBD_robo_hole_dx/2", "-TBD_robo_hole_dy/2"], "diameter": "TBD_robo_hole_d"}},
  {"command": "solid.extrude", "params": {"distance": "plate_t"}},
  {"command": "body.rename", "params": {"body": "Body1", "name": "plate"}},
  {"command": "material.assign", "params": {"bodies": ["plate"], "material": "PLA"}}
]}
